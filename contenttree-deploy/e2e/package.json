{
  "name": "e2e",
  "description": "Content Tree Application E2E tests",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "test:ui": "npm run test -- --ui",
    "install:chromium": "playwright install chromium",
    "generate:openapi": "openapi --input ../../contenttree-backend-springboot/build/openapi.json --output api/types --exportCore false --exportServices false",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.6",
    "openapi-typescript-codegen": "^0.31.0",
    "prettier": "^3.9.10"
  }
}
