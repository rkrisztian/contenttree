{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "allowJs": true,
    "noEmit": true,
    "types": ["k6"],
    "allowImportingTsExtensions": true
  },
  "include": ["tests/**/*.ts", "lib/**/*.ts", "vendor/**/*.js", "vendor/**/*.d.ts"]
}
