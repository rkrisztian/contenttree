{
  "name": "contenttree-frontend-nextjs",
  "description": "Content Tree Application Frontend",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:docker": "docker build --tag contenttree-frontend-nextjs:latest .",
    "prebuild:docker": "npm run build",
    "prebuild": "license-report --only=prod --output=html > public/third-party-licenses.html",
    "openapi:generate": "openapi --input ../contenttree-backend/build/openapi.json --output src/app/_lib/api/types --exportCore false --exportServices false",
    "test": "vitest",
    "test:ct": "npm run test -- --config vitest.ct.config.ts",
    "test:ct:headless": "npm run test:ct -- --browser.headless",
    "install:chromium": "playwright install chromium",
    "lint": "biome check",
    "lint:fix": "biome check --fix",
    "lint:ci": "biome ci",
    "lint:dpdm": "dpdm '**/*.ts?(x)' --tree false --warning false"
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.1.1",
    "@mui/material-nextjs": "^9.1.1",
    "axios": "^1.18.1",
    "clsx": "^2.1.1",
    "i18next": "^26.4.1",
    "jose": "^6.2.4",
    "next": "^16.3.1",
    "next-i18next": "^16.0.11",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.81.0",
    "react-i18next": "^17.0.13",
    "swr": "^2.4.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.2.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "babel-plugin-react-compiler": "1.0.0",
    "dpdm": "^4.2.0",
    "jsdom": "^29.1.1",
    "license-report": "^6.8.5",
    "msw": "^2.15.0",
    "openapi-typescript-codegen": "^0.31.0",
    "sass": "^1.101.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "vitest-browser-react": "^2.2.0"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ],
  "allowScripts": {
    "@parcel/watcher@2.5.6": true,
    "msw@2.15.0": true,
    "sharp@0.34.5": true
  }
}
