{
  "name": "contenttree-backend-nestjs",
  "description": "Content Tree Application Backend",
  "author": "",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "NODE_ENV=production nest build",
    "build:docker": "docker build --tag contenttree-backend-nestjs:latest .",
    "prebuild:docker": "npm run build",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "concurrently --kill-others \"docker compose up\" \"wait-on tcp:5432 && nest start --watch\"",
    "start:debug": "concurrently --kill-others \"docker compose up\" \"wait-on tcp:5432 && nest start --watch --debug\"",
    "start:prod": "concurrently --kill-others \"docker compose up\" \"wait-on tcp:5432 && NODE_ENV=production node dist/main\"",
    "lint": "oxlint --type-aware src/ test/",
    "lint:dpdm": "dpdm",
    "test": "vitest",
    "test:debug": "npm run test -- --inspect-brk --no-file-parallelism",
    "test:int": "npm run test -- --config ./vitest.config.int.ts",
    "test:int:debug": "npm run test:int -- --inspect-brk --no-file-parallelism"
  },
  "dependencies": {
    "@nestjs-cls/transactional": "^4.0.1",
    "@nestjs-cls/transactional-adapter-typeorm": "^2.0.1",
    "@nestjs/common": "^12.2.0",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/swagger": "^12.0.4",
    "@nestjs/typeorm": "^12.0.2",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "nestjs-cls": "^7.0.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^1.1.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.10",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.10",
    "@nestjs/testing": "^12.0.1",
    "@testcontainers/postgresql": "^12.2.1",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^26.6.5",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.12",
    "concurrently": "^10.0.6",
    "dpdm": "^4.3.0",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.3.1",
    "typescript": "^6.0.2",
    "vitest": "^4.1.12",
    "wait-on": "^9.5.1"
  },
  "allowScripts": {
    "@scarf/scarf@1.4.0": true,
    "bcrypt@6.0.0": true,
    "cpu-features@0.0.10": true,
    "protobufjs@7.6.6": true,
    "ssh2@1.17.0": true
  }
}
