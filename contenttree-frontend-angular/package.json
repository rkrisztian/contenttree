{
  "name": "contenttree-frontend-angular",
  "description": "Content Tree Application Frontend",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "build:docker": "docker build --tag contenttree-frontend-angular:latest .",
    "prebuild:docker": "npm run build",
    "openapi:generate": "openapi --input ../contenttree-backend/build/openapi.json --output src/app/api/types --exportCore false --exportServices false",
    "test": "ng test",
    "test:ct": "npm run test -- --configuration ct",
    "test:ct:headless": "npm run test:ct -- --headless",
    "install:chromium": "playwright install chromium",
    "lint": "ng lint",
    "lint:dpdm": "dpdm '**/*.ts' --tree false --warning false",
    "lint:sonar": "eslint ./ --format json > eslint-report.json",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "packageManager": "npm@11.16.0",
  "dependencies": {
    "@angular/cdk": "^22.0.6",
    "@angular/common": "^22.0.8",
    "@angular/compiler": "^22.0.8",
    "@angular/core": "^22.0.8",
    "@angular/forms": "^22.0.8",
    "@angular/material": "^22.0.6",
    "@angular/platform-browser": "^22.0.8",
    "@angular/router": "^22.0.8",
    "@fontsource/material-icons": "^5.2.7",
    "@fontsource/roboto": "^5.2.10",
    "jose": "^6.2.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^22.0.9",
    "@angular/cli": "^22.0.9",
    "@angular/compiler-cli": "^22.0.8",
    "@eslint/js": "^10.0.1",
    "@prettier/plugin-yuku": "^0.0.1",
    "@vitest/browser-playwright": "^4.1.8",
    "@vitest/coverage-v8": "^4.1.10",
    "angular-eslint": "^22.1.0",
    "dpdm": "^4.2.0",
    "eslint": "^10.8.0",
    "jsdom": "^28.1.0",
    "msw": "^2.14.6",
    "openapi-typescript-codegen": "^0.31.0",
    "prettier": "^3.8.4",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.0.8",
    "vitest-browser-angular": "^0.5.0"
  },
  "allowScripts": {
    "msw@2.14.6": true,
    "@parcel/watcher@2.5.6": true,
    "esbuild@0.28.1": true,
    "esbuild@0.27.7": true,
    "msgpackr-extract@3.0.4": true,
    "lmdb@3.5.4": true
  }
}
