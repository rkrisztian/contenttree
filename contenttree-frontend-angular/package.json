{
  "name": "contenttree-frontend-angular",
  "description": "Content Tree Application Frontend",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "build:docker": "docker build --tag contenttree-frontend-angular:latest .",
    "prebuild:docker": "npm run build",
    "generate:openapi": "openapi --input ../contenttree-backend-springboot/build/openapi.json --output src/app/api/types --exportCore false --exportServices false",
    "test": "ng test",
    "test:ct": "npm run test -- --configuration ct",
    "test:ct:headless": "npm run test:ct -- --headless",
    "install:chromium": "playwright install chromium",
    "lint": "npm run lint:ts && npm run lint:style && npm run lint:dpdm && npm run format:check",
    "lint:ts": "ng lint",
    "lint:style": "stylelint \"src/**/*.scss\"",
    "lint:dpdm": "dpdm",
    "lint:sonar": "eslint ./ --format json > eslint-report.json",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "packageManager": "npm@11.16.0",
  "dependencies": {
    "@angular/cdk": "^22.2.5",
    "@angular/common": "^22.2.4",
    "@angular/compiler": "^22.2.4",
    "@angular/core": "^22.2.4",
    "@angular/forms": "^22.2.4",
    "@angular/material": "^22.2.5",
    "@angular/platform-browser": "^22.2.4",
    "@angular/router": "^22.2.4",
    "@fontsource/material-icons": "^5.3.0",
    "@fontsource/roboto": "^5.3.0",
    "@ngx-translate/core": "^18.0.0",
    "@ngx-translate/http-loader": "^18.0.0",
    "jose": "^6.2.15",
    "rxjs": "~7.8.0",
    "tslib": "^2.9.1"
  },
  "devDependencies": {
    "@angular/build": "^22.2.5",
    "@angular/cli": "^22.2.5",
    "@angular/compiler-cli": "^22.2.4",
    "@eslint/js": "^10.0.1",
    "@prettier/plugin-yuku": "^0.0.2",
    "@vitest/browser-playwright": "^5.1.0",
    "@vitest/coverage-v8": "^5.1.0",
    "angular-eslint": "^22.6.0",
    "dpdm": "^4.3.0",
    "eslint": "^10.14.0",
    "jsdom": "^30.1.3",
    "msw": "^3.0.3",
    "openapi-typescript-codegen": "^0.31.0",
    "playwright": "^1.63.0",
    "prettier": "^3.9.10",
    "stylelint": "^17.16.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0",
    "vitest-browser-angular": "^0.5.1"
  },
  "allowScripts": {
    "msgpackr-extract@3.0.4": true,
    "@parcel/watcher@2.6.0": true,
    "esbuild@0.28.2": true,
    "lmdb@3.5.6": true,
    "msw@2.15.0": true
  }
}
