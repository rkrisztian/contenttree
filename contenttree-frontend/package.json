{
  "name": "contenttree",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "build:docker": "docker build --tag contenttree-frontend:latest .",
    "prebuild:docker": "npm run build",
    "openapi:generate": "npx openapi-typescript ../contenttree-backend/build/openapi.json -o src/app/api/schema.d.ts",
    "test": "ng test",
    "test:ct": "npm run test -- --configuration ct",
    "test:ct:headless": "npm run test:ct -- --headless",
    "lint": "ng lint",
    "lint:sonar": "eslint ./ --format json > eslint-report.json"
  },
  "packageManager": "npm@11.12.1",
  "dependencies": {
    "@angular/animations": "^22.0.1",
    "@angular/cdk": "^21.2.13",
    "@angular/common": "^22.0.1",
    "@angular/compiler": "^21.2.15",
    "@angular/core": "^22.0.1",
    "@angular/forms": "^22.0.1",
    "@angular/material": "^21.2.13",
    "@angular/platform-browser": "^22.0.1",
    "@angular/router": "^22.0.1",
    "@fontsource/material-icons": "^5.2.7",
    "@fontsource/roboto": "^5.2.10",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.0.1",
    "@angular/cli": "^21.2.13",
    "@angular/compiler-cli": "^21.2.15",
    "@eslint/js": "^10.0.1",
    "@vitest/browser-playwright": "^4.1.8",
    "@vitest/coverage-v8": "^4.1.6",
    "angular-eslint": "21.4.0",
    "eslint": "^10.4.1",
    "jsdom": "^28.0.0",
    "msw": "^2.14.6",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "typescript-eslint": "8.56.1",
    "vitest": "^4.0.8",
    "vitest-browser-angular": "^0.5.0"
  }
}
